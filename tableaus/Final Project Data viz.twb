            <column caption='Asset Class' datatype='string' name='[asset_class]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;COMMODITIES&quot;' value='Commodities Avg. 1Y return' />
                <alias key='&quot;CRYPTO&quot;' value='Crypto Avg. 1Y Return' />
                <alias key='&quot;INTL&quot;' value='Intl Equity Avg. 1Y Return' />
              </aliases>
            </column>
            <column-instance column='[Calculation_0649049740054530]' derivation='Avg' name='[avg:Calculation_0649049740054530:qk]' pivot='key' type='quantitative' />
            <column caption='Country' datatype='string' name='[country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
