              <calculation class='tableau' formula='IF CONTAINS([country], &apos;United States&apos;) THEN &apos;US&apos;&#10;ELSEIF CONTAINS([country],&apos;China&apos;) OR CONTAINS([country],&apos;Japan&apos;) OR CONTAINS([country],&apos;South Korea&apos;) OR CONTAINS([country],&apos;Hong Kong&apos;) OR CONTAINS([country],&apos;India&apos;) OR CONTAINS([country],&apos;Taiwan&apos;) OR CONTAINS([country],&apos;Australia&apos;) OR CONTAINS([country],&apos;Israel&apos;) THEN &apos;Asia&apos;&#10;ELSEIF CONTAINS([country],&apos;Denmark&apos;) OR CONTAINS([country],&apos;France&apos;) OR CONTAINS([country],&apos;Germany&apos;) OR CONTAINS([country],&apos;Ireland&apos;) OR CONTAINS([country],&apos;Netherlands&apos;) OR CONTAINS([country],&apos;Spain&apos;) OR CONTAINS([country],&apos;Switzerland&apos;) OR CONTAINS([country],&apos;United Kingdom&apos;) THEN &apos;Europe&apos;&#10;ELSEIF CONTAINS([country],&apos;Uruguay&apos;) OR CONTAINS([country],&apos;Brazil&apos;) OR CONTAINS([country],&apos;Cayman Islands&apos;) THEN &apos;LatAm&apos;&#10;ELSEIF CONTAINS([country],&apos;Canda&apos; ) OR CONTAINS([country],&apos;United States&apos;) THEN &apos;North America&apos;&#10;END' />
            </column>
            <column caption='Region' datatype='string' name='[Calculation_0649049729097728]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [asset_class] = &apos;US_MEGA&apos; or [asset_class] = &apos;US_MID&apos; THEN &apos;US Equity&apos;&#10;ELSEIF [asset_class] = &apos;INTL&apos; AND CONTAINS([Calculation_0392175642636289], &apos;Asia&apos;) THEN &apos;Asia-Pacific&apos;&#10;ELSEIF [asset_class] = &apos;INTL&apos; AND CONTAINS([Calculation_0392175642636289], &apos;Europe&apos;) THEN &apos;Europe&apos;&#10;ELSEIF [asset_class] = &apos;INTL&apos; AND CONTAINS([Calculation_0392175642636289], &apos;LatAm&apos;) THEN &apos;LatAm&apos;&#10;ELSEIF [asset_class] = &apos;CRYPTO&apos; THEN &apos;Crypto&apos;&#10;ELSEIF [asset_class] = &apos;COMMODITIES&apos; THEN &apos;Commodities&apos;&#10;END' />
